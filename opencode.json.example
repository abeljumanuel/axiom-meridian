{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "meridian": {
      "type": "local",
      "command": ["/path/to/meridian/.venv/bin/meridian", "mcp"],
      "environment": {
        "MERIDIAN_ACCESS_LEVEL": "write"
      }
    }
  },
  "permission": {
    "mcp": {
      "meridian": "ask"
    }
  }
}
